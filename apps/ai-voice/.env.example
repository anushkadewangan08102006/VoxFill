# ─────────────────────────────────────────────────
# FormPilot AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ── Ollama (Local LLM) ───────────────────────────
# Base URL of the running Ollama process
OLLAMA_BASE_URL=http://localhost:11434
# Model to use — llama3.2:3b is fast, good for demos
# Alternatives: mistral:7b (higher quality, slower)
OLLAMA_MODEL=llama3.2:3b
# Max ms to wait for an LLM response before timeout
OLLAMA_TIMEOUT_MS=30000

# ── Whisper STT ──────────────────────────────────
# Whisper model size: tiny.en | base.en | small.en | medium.en
# base.en is the sweet spot for speed vs accuracy on a laptop
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
# Directory where incoming audio files are stored before transcription
AUDIO_TEMP_DIR=./tmp/audio

# ── Piper TTS ────────────────────────────────────
# Full path to the Piper binary on this machine
PIPER_BINARY_PATH=/usr/local/bin/piper
# Path to the .onnx voice model file
PIPER_VOICE_MODEL=./models/en_US-lessac-medium.onnx
# Directory where TTS output .wav files are written
TTS_OUTPUT_DIR=./tmp/tts

# ── Asterisk AMI (Manager Interface) ─────────────
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=formpilot
AMI_PASSWORD=change_this_in_production
# How long (ms) to wait before reconnecting on AMI disconnect
AMI_RECONNECT_DELAY_MS=3000

# ── Session Management ───────────────────────────
# How long (seconds) an inactive session is kept alive
SESSION_TTL_SECONDS=1800

# ── Backend Integration (Member 3's API) ─────────
BACKEND_API_URL=http://localhost:3000
BACKEND_API_KEY=shared_secret_with_member3
